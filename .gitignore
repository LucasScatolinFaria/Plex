# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo (dist/ é o site gerado pelo "expo export", que o firebase deploy publica)
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
desktop.ini

# local env files (o modelo versionado é o .env.example)
.env
.env*.local

# Firebase: cache do deploy, logs da CLI e dos emuladores, dados exportados dos emuladores
.firebase/
*-debug.log
firebase-export-*/
emulator-data/

# Chaves de conta de serviço do Google Cloud dão acesso total ao projeto: nunca vão para o Git
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo
